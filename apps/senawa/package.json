{
  "name": "senawa",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "bin": {
    "senawa": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/fixtures/**",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@senawa/configuration": "workspace:*",
    "@senawa/execution-host": "workspace:*",
    "@senawa/kernel": "workspace:*",
    "@senawa/protocol": "workspace:*",
    "@senawa/reporting": "workspace:*",
    "@senawa/runtime": "workspace:*",
    "@senawa/storage-sqlite": "workspace:*",
    "@senawa/supervisor": "workspace:*"
  },
  "devDependencies": {
    "@senawa/control-plane": "workspace:*",
    "@senawa/testing": "workspace:*"
  }
}
