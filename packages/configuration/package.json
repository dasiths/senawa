{
  "name": "@senawa/configuration",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/fixtures/**",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@senawa/kernel": "workspace:*",
    "ajv": "8.18.0",
    "json-schema-traverse": "1.0.0",
    "yaml": "2.6.1"
  }
}
