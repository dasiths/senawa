{
  "name": "@senawa/execution-host",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/fixtures/**",
    "!dist/**/*fixture*",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "executableFiles": [
      "dist/senawa-process-supervisor",
      "dist/senawa-workspace-files"
    ]
  },
  "scripts": {
    "build": "tsc -b && pnpm build:native",
    "build:native": "node ../../scripts/build-process-supervisor.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@senawa/configuration": "workspace:*",
    "@senawa/kernel": "workspace:*",
    "@senawa/protocol": "workspace:*",
    "@senawa/runtime": "workspace:*"
  },
  "peerDependencies": {
    "@github/copilot-sdk": "1.0.9"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.9"
  }
}
