{
  "name": "@senawa/storage-sqlite",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporting-snapshot": {
      "types": "./dist/reporting-snapshot.d.ts",
      "default": "./dist/reporting-snapshot.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "!dist/**/*.test.*",
    "!dist/**/fixtures/**",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@senawa/configuration": "workspace:*",
    "@senawa/kernel": "workspace:*",
    "@senawa/protocol": "workspace:*",
    "@senawa/runtime": "workspace:*",
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@senawa/testing": "workspace:*",
    "@types/better-sqlite3": "9.6.0"
  }
}
