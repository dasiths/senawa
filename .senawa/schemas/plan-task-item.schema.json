{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:senawa:standard-delivery:plan-task-item",
  "type": "object",
  "required": [
    "dependsOn",
    "id",
    "instruction",
    "title"
  ],
  "properties": {
    "dependsOn": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "additionalProperties": false
}
