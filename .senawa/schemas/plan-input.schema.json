{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:senawa:plan-input",
  "title": "Plan phase input",
  "description": "Named here because the plan phase has two upstreams. Senawa binds each property to the upstream output that provides it.",
  "type": "object",
  "required": ["definition", "research"],
  "properties": {
    "definition": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "research": { "type": "string", "minLength": 1, "maxLength": 65536 }
  },
  "additionalProperties": false
}
