{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:senawa:research",
  "title": "Research phase output",
  "type": "object",
  "required": ["research", "findings"],
  "properties": {
    "research": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "description": "What is true about the codebase today."
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["claim", "evidence"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "The file, and where relevant the symbol, supporting the claim."
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "additionalProperties": false
}
