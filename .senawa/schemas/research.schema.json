{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senawa.dev/schemas/research/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source", "evidenceKind"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "evidenceKind": {
            "enum": ["measured", "offline", "live-model", "simulated", "documentation"]
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
