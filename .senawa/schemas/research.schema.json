{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senawa.dev/schemas/research/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source", "evidenceKind"],
        "properties": {
          "id": {
            "$ref": "#/$defs/artifactId"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "evidenceKind": {
            "$ref": "#/$defs/evidenceKind"
          },
          "confidence": {
            "$ref": "#/$defs/level"
          },
          "limits": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "description": "What this finding does not prove."
          },
          "answers": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/artifactId"
            },
            "description": "Ids of the questions this finding answers."
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "status"],
        "properties": {
          "id": {
            "$ref": "#/$defs/artifactId"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "enum": ["answered", "partial", "unanswered"]
          },
          "answeredBy": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/artifactId"
            }
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "verdict", "rationale"],
        "properties": {
          "id": {
            "$ref": "#/$defs/artifactId"
          },
          "option": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "verdict": {
            "enum": ["recommended", "viable", "rejected"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "tradeoffs": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/artifactId"
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraintEntry"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question"],
        "properties": {
          "id": {
            "$ref": "#/$defs/artifactId"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "nextResearch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "blocking": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendationObject"
      }
    }
  },
  "$defs": {
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "description": "An id you choose to cross-reference entries inside this artifact. Any case is accepted; no spaces or slashes."
    },
    "level": {
      "enum": ["high", "medium", "low"]
    },
    "evidenceKind": {
      "enum": ["measured", "offline", "live-model", "simulated", "documentation"]
    },
    "recommendationObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "basis": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/artifactId"
          },
          "description": "Ids of the findings that support this recommendation."
        },
        "confidence": {
          "$ref": "#/$defs/level"
        },
        "alternativesRejected": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/artifactId"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "mitigation"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "likelihood": {
          "$ref": "#/$defs/level"
        },
        "impact": {
          "$ref": "#/$defs/level"
        },
        "mitigation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "constraintEntry": {
      "$ref": "#/$defs/constraintObject"
    },
    "constraintObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "enum": ["policy", "technical", "process", "external"]
        }
      }
    }
  }
}
