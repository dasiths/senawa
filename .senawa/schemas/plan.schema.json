{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senawa.dev/schemas/plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "tasks"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "contextSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "phases": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/phase"
      },
      "description": "Ordered delivery phases. When present, every task must name a phase, and Senawa expands each task's dependsOn with the tasks of its predecessor phases at import."
    },
    "decisions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "enum": ["internal", "external", "artifact", "contract"]
          },
          "blocking": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "successCriteria": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/successCriterion"
      }
    },
    "validation": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/validationCommand"
      }
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/openQuestionEntry"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "paths", "acceptance", "role"],
        "properties": {
          "key": {
            "$ref": "#/$defs/artifactId"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifactId"
            }
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "repositoryChange": {
            "enum": ["required", "optional", "forbidden"]
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/$defs/acceptanceCriterion"
            }
          },
          "role": {
            "$ref": "#/$defs/identifier"
          },
          "phase": {
            "$ref": "#/$defs/artifactId"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              },
              "effort": {
                "enum": ["low", "medium", "high", "xhigh"]
              },
              "effortMode": {
                "enum": ["required", "preferred"]
              },
              "group": {
                "$ref": "#/$defs/artifactId"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "satisfies": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/artifactId"
          },
          "description": "Ids of the definition criteria this task criterion contributes to."
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "parallelizable": {
          "type": "boolean",
          "default": false,
          "description": "Authoring signal only. The task frontier caps concurrency at 1, so this never changes scheduling today."
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/artifactId"
          }
        },
        "todos": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/phaseTodo"
          }
        },
        "exitCriteria": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "validation": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/validationCommand"
          }
        }
      }
    },
    "phaseTodo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "taskKey": {
          "$ref": "#/$defs/artifactId"
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "enum": ["proposed", "accepted", "superseded"],
          "default": "proposed"
        },
        "evidence": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "alternativesRejected": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "reason"],
            "properties": {
              "option": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "successCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "satisfies": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/artifactId"
          }
        }
      }
    },
    "validationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "description": "Declarative documentation. Only .senawa/sensors.yaml command sensors execute anything.",
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "expect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "blocking": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "mitigation"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "likelihood": {
          "$ref": "#/$defs/level"
        },
        "impact": {
          "$ref": "#/$defs/level"
        },
        "mitigation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "openQuestionEntry": {
      "$ref": "#/$defs/openQuestionObject"
    },
    "openQuestionObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "blocking": {
          "type": "boolean",
          "default": false
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "level": {
      "enum": ["high", "medium", "low"]
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "description": "An id you choose for a task, phase, or criterion in this plan. Any case is accepted; no spaces or slashes."
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "description": "A name the repository already defines, such as a worker profile. It must match that name exactly."
    }
  }
}
