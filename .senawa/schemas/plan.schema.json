{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senawa.dev/schemas/plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "tasks"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "paths", "acceptance", "role"],
        "properties": {
          "key": { "$ref": "#/$defs/identifier" },
          "title": { "type": "string", "minLength": 1 },
          "dependsOn": {
            "type": "array",
            "items": { "$ref": "#/$defs/identifier" }
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "repositoryChange": {
            "enum": ["required", "optional", "forbidden"]
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "$ref": "#/$defs/acceptanceCriterion" }
              ]
            }
          },
          "role": { "$ref": "#/$defs/identifier" },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": { "type": "string", "minLength": 1 },
              "effort": { "enum": ["low", "medium", "high", "xhigh"] },
              "effortMode": { "enum": ["required", "preferred"] },
              "group": { "$ref": "#/$defs/identifier" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "required": { "type": "boolean", "default": true }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    }
  }
}
