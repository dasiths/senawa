{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senawa.dev/schemas/verification/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "checks"],
  "properties": {
    "verdict": {
      "enum": ["pass", "fail"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "verdict", "summary"],
        "properties": {
          "id": {
            "$ref": "#/$defs/artifactId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": ["pass", "fail", "error"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "criterionId": {
            "$ref": "#/$defs/artifactId"
          },
          "taskKey": {
            "$ref": "#/$defs/artifactId"
          },
          "phaseId": {
            "$ref": "#/$defs/artifactId"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref"],
              "properties": {
                "kind": {
                  "enum": ["file", "artifact", "sensor", "command", "repository-delta"]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "verdict"],
        "properties": {
          "id": {
            "$ref": "#/$defs/artifactId"
          },
          "source": {
            "enum": ["definition", "plan", "task"]
          },
          "verdict": {
            "enum": ["pass", "fail", "not-verifiable"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "checks": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/artifactId"
            }
          }
        }
      },
      "description": "Worker claims about per-criterion coverage. The driver adjudicates them."
    },
    "phases": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict"],
        "properties": {
          "id": {
            "$ref": "#/$defs/artifactId"
          },
          "verdict": {
            "enum": ["pass", "fail", "not-verifiable"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "checks": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/artifactId"
            }
          },
          "tasks": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/$defs/artifactId"
            }
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "rationale"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "impact": {
            "enum": ["none", "low", "medium", "high"]
          }
        }
      },
      "description": "Honest limits that do not fail the gate, unlike findings."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Unresolved problems. A non-empty findings array fails the work-done gate."
    }
  },
  "$defs": {
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "description": "An id you choose to cross-reference entries inside this artifact, or a task key or plan phase id copied from the plan. Any case is accepted; no spaces or slashes."
    }
  }
}
