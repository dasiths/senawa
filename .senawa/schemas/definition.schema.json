{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:senawa:definition",
  "title": "Definition phase output",
  "description": "What the requested change means, stated precisely enough to judge a proposed solution against.",
  "type": "object",
  "required": [
    "summary",
    "acceptance"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "description": "The problem being solved."
    },
    "documentPath": {
      "$ref": "#/$defs/repositoryPath",
      "description": "Long-form definition written into the repository. Prose lives in the file; this output carries the structure later phases act on."
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "description": "Observable conditions that would make the work correct. The verify phase reports against these by id.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "condition"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "measuredBy": {
            "type": "string",
            "maxLength": 256,
            "description": "Name of the sensor or gate that decides this, where one does."
          }
        },
        "additionalProperties": false
      }
    },
    "outOfScope": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 20,
      "description": "Where the request is unclear. Named rather than resolved silently.",
      "items": {
        "type": "object",
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "assumption": {
            "type": "string",
            "maxLength": 1024,
            "description": "What later phases should assume until a human says otherwise."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Repository-relative path. Absolute paths and parent traversal are refused.",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    }
  }
}
