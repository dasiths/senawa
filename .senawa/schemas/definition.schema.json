{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:senawa:definition",
  "title": "Definition phase output",
  "type": "object",
  "required": ["definition", "acceptance"],
  "properties": {
    "definition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "description": "The problem being solved, stated precisely."
    },
    "outOfScope": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "description": "Observable conditions that would make the work correct.",
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "additionalProperties": false
}
