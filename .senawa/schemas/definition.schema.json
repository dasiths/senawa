{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senawa.dev/schemas/definition/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "inScope", "acceptanceCriteria"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "inScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "outOfScope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
