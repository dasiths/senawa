{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:senawa:standard-delivery:verification-input",
  "type": "object",
  "required": [
    "definition",
    "implementationEvidence",
    "research",
    "tasks"
  ],
  "properties": {
    "definition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "implementationEvidence": {},
    "research": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64
    }
  },
  "additionalProperties": false
}
