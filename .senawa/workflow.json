{
  "apiVersion": "senawa.dev/workflow/v1alpha3",
  "kind": "Workflow",
  "execution": {
    "workspaceMode": "repository",
    "maxWriterConcurrency": 1,
    "failurePolicy": "continue"
  },
  "workflow": {
    "key": "standard-delivery",
    "generation": 1,
    "input": {
      "schema": "workflow-input"
    }
  },
  "prompts": [
    {
      "key": "definer",
      "path": "prompts/definer.md",
      "inputPaths": [
        "/request"
      ]
    },
    {
      "key": "implementor",
      "path": "prompts/implementor.md",
      "inputPaths": [
        "/dependsOn",
        "/id",
        "/instruction",
        "/title"
      ]
    },
    {
      "key": "planner",
      "path": "prompts/planner.md",
      "inputPaths": [
        "/definition",
        "/research"
      ]
    },
    {
      "key": "researcher",
      "path": "prompts/researcher.md",
      "inputPaths": [
        "/definition"
      ]
    },
    {
      "key": "verifier",
      "path": "prompts/verifier.md",
      "inputPaths": [
        "/definition",
        "/implementationEvidence",
        "/research",
        "/tasks"
      ]
    }
  ],
  "schemas": [
    {
      "key": "definition-input",
      "path": "schemas/definition-input.schema.json"
    },
    {
      "key": "definition-output",
      "path": "schemas/definition-output.schema.json"
    },
    {
      "key": "implementation-task-input",
      "path": "schemas/implementation-task-input.schema.json"
    },
    {
      "key": "plan-input",
      "path": "schemas/plan-input.schema.json"
    },
    {
      "key": "plan-output",
      "path": "schemas/plan-output.schema.json"
    },
    {
      "key": "plan-task-collection",
      "path": "schemas/plan-task-collection.schema.json"
    },
    {
      "key": "plan-task-item",
      "path": "schemas/plan-task-item.schema.json"
    },
    {
      "key": "research-input",
      "path": "schemas/research-input.schema.json"
    },
    {
      "key": "research-output",
      "path": "schemas/research-output.schema.json"
    },
    {
      "key": "verification-input",
      "path": "schemas/verification-input.schema.json"
    },
    {
      "key": "verification-output",
      "path": "schemas/verification-output.schema.json"
    },
    {
      "key": "workflow-input",
      "path": "schemas/workflow-input.schema.json"
    }
  ],
  "roles": [
    {
      "key": "definer",
      "kind": "agent",
      "capabilities": [
        "define-delivery"
      ],
      "prompt": "definer",
      "modelPolicy": "standard"
    },
    {
      "key": "implementor",
      "kind": "agent",
      "capabilities": [
        "implement-task"
      ],
      "prompt": "implementor",
      "modelPolicy": "standard"
    },
    {
      "key": "planner",
      "kind": "agent",
      "capabilities": [
        "plan-delivery"
      ],
      "prompt": "planner",
      "modelPolicy": "standard"
    },
    {
      "key": "researcher",
      "kind": "agent",
      "capabilities": [
        "research-delivery"
      ],
      "prompt": "researcher",
      "modelPolicy": "standard"
    },
    {
      "key": "verifier",
      "kind": "agent",
      "capabilities": [
        "verify-delivery"
      ],
      "prompt": "verifier",
      "modelPolicy": "standard"
    }
  ],
  "modelPolicies": [
    {
      "key": "standard",
      "routes": [
        {
          "provider": "openai",
          "model": "gpt-5",
          "maxTurns": 12,
          "maxSubmissions": 4,
          "maxMillidollars": 5000
        }
      ]
    }
  ],
  "sensors": [
    {
      "key": "diff-check",
      "argv": [
        "git",
        "diff",
        "--check"
      ],
      "cwd": ".",
      "timeoutMs": 30000,
      "maxStdoutBytes": 65536,
      "maxStderrBytes": 65536,
      "inheritedEnvironment": [
        "PATH"
      ],
      "maxAttempts": 3,
      "maxReconciliationAttempts": 2
    }
  ],
  "gates": [
    {
      "key": "define-valid",
      "phase": "define",
      "blocking": [
        {
          "key": "clean-diff",
          "condition": {
            "operator": "equals",
            "accessor": {
              "sensorKey": "diff-check",
              "pointer": "/exitCode"
            },
            "expected": 0
          }
        }
      ],
      "advisory": []
    },
    {
      "key": "implement-valid",
      "phase": "implement",
      "blocking": [
        {
          "key": "clean-diff",
          "condition": {
            "operator": "equals",
            "accessor": {
              "sensorKey": "diff-check",
              "pointer": "/exitCode"
            },
            "expected": 0
          }
        }
      ],
      "advisory": []
    },
    {
      "key": "plan-valid",
      "phase": "plan",
      "blocking": [
        {
          "key": "clean-diff",
          "condition": {
            "operator": "equals",
            "accessor": {
              "sensorKey": "diff-check",
              "pointer": "/exitCode"
            },
            "expected": 0
          }
        }
      ],
      "advisory": []
    },
    {
      "key": "research-valid",
      "phase": "research",
      "blocking": [
        {
          "key": "clean-diff",
          "condition": {
            "operator": "equals",
            "accessor": {
              "sensorKey": "diff-check",
              "pointer": "/exitCode"
            },
            "expected": 0
          }
        }
      ],
      "advisory": []
    },
    {
      "key": "verification-valid",
      "phase": "verify",
      "blocking": [
        {
          "key": "clean-diff",
          "condition": {
            "operator": "equals",
            "accessor": {
              "sensorKey": "diff-check",
              "pointer": "/exitCode"
            },
            "expected": 0
          }
        }
      ],
      "advisory": []
    }
  ],
  "implementationEvidenceViews": [
    {
      "key": "accepted-implementation",
      "phase": "implement",
      "evidenceKinds": [
        "task-completion"
      ],
      "sensitivityCeiling": "internal"
    }
  ],
  "forEach": [
    {
      "key": "plan-tasks",
      "source": {
        "kind": "phase-output",
        "phase": "plan",
        "output": "plan"
      },
      "pointer": "/tasks",
      "collectionSchema": "plan-task-collection",
      "itemSchema": "plan-task-item",
      "identityPointer": "/id",
      "limits": {
        "maxSelectedItems": 64,
        "maxTotalTasks": 256,
        "maxConcurrency": 1,
        "exhaustion": "escalate"
      }
    }
  ],
  "taskTemplates": [
    {
      "key": "implementation",
      "generation": 1,
      "role": "implementor",
      "budgets": [
        {
          "unit": "work-attempt",
          "limit": 3
        },
        {
          "unit": "dispatch-failure",
          "limit": 2
        },
        {
          "unit": "sensor-retry",
          "limit": 2
        },
        {
          "unit": "review-iteration",
          "limit": 2
        },
        {
          "unit": "integration-attempt",
          "limit": 2
        },
        {
          "unit": "rebase-attempt",
          "limit": 2
        }
      ],
      "inputSchema": "implementation-task-input",
      "inputMappings": [
        {
          "key": "plan-item",
          "source": {
            "kind": "current-item",
            "pointer": ""
          },
          "destinationPointer": ""
        }
      ],
      "dependencyIdentityPointer": "/dependsOn",
      "repositoryChanges": "required",
      "completionPolicy": {
        "criteria": [
          {
            "key": "implemented",
            "generation": 1,
            "required": true,
            "input": null
          }
        ],
        "evidencePolicy": {
          "mode": "task",
          "requirements": [
            {
              "kind": "task-completion",
              "minimumCount": 1
            }
          ]
        }
      }
    }
  ],
  "phases": [
    {
      "key": "define",
      "generation": 1,
      "dependsOn": [],
      "input": {
        "schema": "definition-input",
        "mappings": [
          {
            "key": "request",
            "source": {
              "kind": "workflow-input",
              "pointer": "/request"
            },
            "destinationPointer": "/request"
          }
        ]
      },
      "executor": {
        "kind": "agent",
        "role": "definer",
        "budgets": [
          {
            "unit": "work-attempt",
            "limit": 3
          },
          {
            "unit": "dispatch-failure",
            "limit": 2
          },
          {
            "unit": "sensor-retry",
            "limit": 2
          },
          {
            "unit": "review-iteration",
            "limit": 2
          },
          {
            "unit": "integration-attempt",
            "limit": 2
          },
          {
            "unit": "rebase-attempt",
            "limit": 2
          }
        ],
        "completionPolicy": {
          "criteria": [
            {
              "key": "define-produced",
              "generation": 1,
              "required": true,
              "input": null
            }
          ],
          "evidencePolicy": {
            "mode": "none",
            "requirements": []
          }
        },
        "resumeAcrossAttempts": true
      },
      "outputs": [
        {
          "key": "definition",
          "schema": "definition-output",
          "path": "outputs/definition.json",
          "maxBytes": 65536,
          "sensitivity": "internal"
        }
      ],
      "iteration": {
        "maximumAttempts": 2,
        "onGateRejected": "iterate",
        "onApprovalRejected": "iterate",
        "onExhausted": "escalate"
      },
      "exit": {
        "requiredOutputs": [
          "definition"
        ],
        "gate": "define-valid",
        "approval": {
          "policy": "required",
          "authority": {
            "role": "release-manager"
          }
        }
      },
      "actions": []
    },
    {
      "key": "research",
      "generation": 1,
      "dependsOn": [
        "define"
      ],
      "input": {
        "schema": "research-input",
        "mappings": [
          {
            "key": "definition",
            "source": {
              "kind": "phase-output",
              "phase": "define",
              "output": "definition",
              "pointer": "/definition"
            },
            "destinationPointer": "/definition"
          }
        ]
      },
      "executor": {
        "kind": "agent",
        "role": "researcher",
        "budgets": [
          {
            "unit": "work-attempt",
            "limit": 3
          },
          {
            "unit": "dispatch-failure",
            "limit": 2
          },
          {
            "unit": "sensor-retry",
            "limit": 2
          },
          {
            "unit": "review-iteration",
            "limit": 2
          },
          {
            "unit": "integration-attempt",
            "limit": 2
          },
          {
            "unit": "rebase-attempt",
            "limit": 2
          }
        ],
        "completionPolicy": {
          "criteria": [
            {
              "key": "research-produced",
              "generation": 1,
              "required": true,
              "input": null
            }
          ],
          "evidencePolicy": {
            "mode": "none",
            "requirements": []
          }
        },
        "resumeAcrossAttempts": true
      },
      "outputs": [
        {
          "key": "research",
          "schema": "research-output",
          "path": "outputs/research.json",
          "maxBytes": 131072,
          "sensitivity": "internal"
        }
      ],
      "iteration": {
        "maximumAttempts": 2,
        "onGateRejected": "iterate",
        "onApprovalRejected": "iterate",
        "onUpstreamChanged": "iterate",
        "onExhausted": "escalate"
      },
      "exit": {
        "requiredOutputs": [
          "research"
        ],
        "gate": "research-valid",
        "approval": {
          "policy": "required",
          "authority": {
            "role": "release-manager"
          }
        }
      },
      "actions": []
    },
    {
      "key": "plan",
      "generation": 1,
      "dependsOn": [
        "define",
        "research"
      ],
      "input": {
        "schema": "plan-input",
        "mappings": [
          {
            "key": "definition",
            "source": {
              "kind": "phase-output",
              "phase": "define",
              "output": "definition",
              "pointer": "/definition"
            },
            "destinationPointer": "/definition"
          },
          {
            "key": "research",
            "source": {
              "kind": "phase-output",
              "phase": "research",
              "output": "research",
              "pointer": "/research"
            },
            "destinationPointer": "/research"
          }
        ]
      },
      "executor": {
        "kind": "agent",
        "role": "planner",
        "budgets": [
          {
            "unit": "work-attempt",
            "limit": 3
          },
          {
            "unit": "dispatch-failure",
            "limit": 2
          },
          {
            "unit": "sensor-retry",
            "limit": 2
          },
          {
            "unit": "review-iteration",
            "limit": 2
          },
          {
            "unit": "integration-attempt",
            "limit": 2
          },
          {
            "unit": "rebase-attempt",
            "limit": 2
          }
        ],
        "completionPolicy": {
          "criteria": [
            {
              "key": "plan-produced",
              "generation": 1,
              "required": true,
              "input": null
            }
          ],
          "evidencePolicy": {
            "mode": "none",
            "requirements": []
          }
        },
        "resumeAcrossAttempts": true
      },
      "outputs": [
        {
          "key": "plan",
          "schema": "plan-output",
          "path": "outputs/plan.json",
          "maxBytes": 262144,
          "sensitivity": "internal"
        }
      ],
      "iteration": {
        "maximumAttempts": 2,
        "onGateRejected": "iterate",
        "onApprovalRejected": "iterate",
        "onUpstreamChanged": "iterate",
        "onExhausted": "escalate"
      },
      "exit": {
        "requiredOutputs": [
          "plan"
        ],
        "gate": "plan-valid",
        "approval": {
          "policy": "required",
          "authority": {
            "role": "release-manager"
          }
        }
      },
      "actions": [
        {
          "kind": "import-plan",
          "forEach": "plan-tasks"
        }
      ]
    },
    {
      "key": "implement",
      "generation": 1,
      "dependsOn": [
        "plan"
      ],
      "input": {
        "schema": "plan-output",
        "mappings": [
          {
            "key": "plan",
            "source": {
              "kind": "phase-output",
              "phase": "plan",
              "output": "plan",
              "pointer": ""
            },
            "destinationPointer": ""
          }
        ]
      },
      "executor": {
        "kind": "task-frontier",
        "forEach": "plan-tasks",
        "template": "implementation"
      },
      "outputs": [],
      "iteration": {
        "maximumAttempts": 1,
        "onGateRejected": "fail",
        "onApprovalRejected": "fail",
        "onUpstreamChanged": "fail",
        "onExhausted": "escalate"
      },
      "exit": {
        "requiredOutputs": [],
        "gate": "implement-valid",
        "approval": {
          "policy": "required",
          "authority": {
            "role": "release-manager"
          }
        }
      },
      "actions": []
    },
    {
      "key": "verify",
      "generation": 1,
      "dependsOn": [
        "define",
        "implement",
        "plan",
        "research"
      ],
      "input": {
        "schema": "verification-input",
        "mappings": [
          {
            "key": "definition",
            "source": {
              "kind": "phase-output",
              "phase": "define",
              "output": "definition",
              "pointer": "/definition"
            },
            "destinationPointer": "/definition"
          },
          {
            "key": "implementation-evidence",
            "source": {
              "kind": "implementation-evidence",
              "phase": "implement",
              "view": "accepted-implementation",
              "pointer": ""
            },
            "destinationPointer": "/implementationEvidence"
          },
          {
            "key": "research",
            "source": {
              "kind": "phase-output",
              "phase": "research",
              "output": "research",
              "pointer": "/research"
            },
            "destinationPointer": "/research"
          },
          {
            "key": "tasks",
            "source": {
              "kind": "phase-output",
              "phase": "plan",
              "output": "plan",
              "pointer": "/tasks"
            },
            "destinationPointer": "/tasks"
          }
        ]
      },
      "executor": {
        "kind": "agent",
        "role": "verifier",
        "budgets": [
          {
            "unit": "work-attempt",
            "limit": 3
          },
          {
            "unit": "dispatch-failure",
            "limit": 2
          },
          {
            "unit": "sensor-retry",
            "limit": 2
          },
          {
            "unit": "review-iteration",
            "limit": 2
          },
          {
            "unit": "integration-attempt",
            "limit": 2
          },
          {
            "unit": "rebase-attempt",
            "limit": 2
          }
        ],
        "completionPolicy": {
          "criteria": [
            {
              "key": "verify-produced",
              "generation": 1,
              "required": true,
              "input": null
            }
          ],
          "evidencePolicy": {
            "mode": "none",
            "requirements": []
          }
        },
        "resumeAcrossAttempts": true
      },
      "outputs": [
        {
          "key": "verification",
          "schema": "verification-output",
          "path": "outputs/verification.json",
          "maxBytes": 131072,
          "sensitivity": "internal"
        }
      ],
      "iteration": {
        "maximumAttempts": 2,
        "onGateRejected": "iterate",
        "onApprovalRejected": "iterate",
        "onUpstreamChanged": "iterate",
        "onExhausted": "escalate"
      },
      "exit": {
        "requiredOutputs": [
          "verification"
        ],
        "gate": "verification-valid",
        "approval": {
          "policy": "required",
          "authority": {
            "role": "release-manager"
          }
        }
      },
      "actions": []
    }
  ]
}
