{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "apps/*/src/**/*.ts",
      "apps/*/package.json",
      "apps/*/tsconfig.json",
      "packages/*/src/**/*.ts",
      "packages/portal/src/**/*.css",
      "packages/portal/index.html",
      "packages/portal/vite.config.ts",
      "packages/*/tests/**/*.ts",
      "packages/*/package.json",
      "packages/*/tsconfig.json",
      "scripts/**/*.mjs",
      "*.json",
      "*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  }
}
