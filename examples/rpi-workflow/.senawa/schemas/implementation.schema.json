{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpi:implementation",
  "title": "What one member changed",
  "type": "object",
  "required": ["taskId", "summary", "files"],
  "properties": {
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "description": "A path this member wrote, relative to the project root."
      }
    }
  },
  "additionalProperties": false
}
