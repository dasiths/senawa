{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpi:research",
  "title": "What is true before anything changes",
  "type": "object",
  "required": ["summary", "findings", "decisions"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "decisions": {
      "description": "What the person was asked and what they answered. Required, and required to be non-empty, so a run cannot reach the planner on choices nobody was offered.",
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["statement", "basis"],
        "properties": {
          "statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "How this was established. A file that was read, a command that was run."
          }
        },
        "additionalProperties": false
      }
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "additionalProperties": false
}
