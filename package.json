{
  "name": "senawa-workspace",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "benchmark:sqlite-authority": "pnpm build && node scripts/benchmark-sqlite-authority.mjs",
    "build": "tsc -b && node scripts/stage-standard-template.mjs && pnpm --filter @senawa/portal build && node scripts/stage-portal-assets.mjs && pnpm --filter @senawa/execution-host build:native",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:links": "node scripts/check-markdown-links.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "package:alpha": "node scripts/package-alpha.mjs",
    "test": "vitest run --passWithNoTests",
    "test:live-worker": "node scripts/test-live-worker.mjs",
    "test:packaging": "node scripts/test-packaging.mjs",
    "test:portal": "pnpm build && playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "1.62.1",
    "@types/node": "22.17.2",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
