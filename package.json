{
  "name": "senawa-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bundle:check": "node scripts/check-bundles.mjs",
    "demo": "pnpm build && node examples/demos/file-offline/run.mjs",
    "demo:live": "pnpm build && node examples/demos/live-copilot-worker/run.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "22.17.2",
    "esbuild": "0.25.12",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
